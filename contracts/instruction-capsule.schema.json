{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.effectgate.dev/v1/instruction-capsule.schema.json",
  "title": "EffectGate V1 Instruction Capsule",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "capsule_id",
    "skill_id",
    "skill_version",
    "skill_digest",
    "phase",
    "phase_revision",
    "invariants",
    "instructions",
    "allowed_tools",
    "transition_conditions",
    "budget",
    "provenance",
    "capsule_digest",
    "expires_at"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "capsule_id": {
      "type": "string",
      "pattern": "^cap_[A-Za-z0-9_-]{16,128}$"
    },
    "skill_id": {"$ref": "#/$defs/name"},
    "skill_version": {"$ref": "#/$defs/version"},
    "skill_digest": {"$ref": "#/$defs/digest"},
    "phase": {"$ref": "#/$defs/name"},
    "phase_revision": {"type": "integer", "minimum": 1},
    "invariants": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/instruction"}
    },
    "instructions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/instruction"}
    },
    "allowed_tools": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/allowedTool"}
    },
    "transition_conditions": {"$ref": "#/$defs/transitionConditions"},
    "budget": {"$ref": "#/$defs/budget"},
    "provenance": {"$ref": "#/$defs/provenance"},
    "capsule_digest": {"$ref": "#/$defs/digest"},
    "expires_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "version": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "reference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "effectClass": {
      "enum": [
        "observe",
        "disclose",
        "mutate_reversible",
        "mutate_irreversible",
        "destructive",
        "external_commit",
        "credential_use",
        "code_execution",
        "unknown"
      ]
    },
    "instruction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "source_ref"],
      "properties": {
        "id": {"$ref": "#/$defs/name"},
        "text": {"type": "string", "minLength": 1, "maxLength": 262144},
        "source_ref": {"$ref": "#/$defs/reference"}
      }
    },
    "allowedTool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability_id", "capability_revision", "effect_class"],
      "properties": {
        "capability_id": {"type": "string", "minLength": 1, "maxLength": 512},
        "capability_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "effect_class": {"$ref": "#/$defs/effectClass"}
      }
    },
    "transitionConditions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["success", "failure"],
      "properties": {
        "success": {"type": "string", "minLength": 1, "maxLength": 2048},
        "failure": {"type": "string", "minLength": 1, "maxLength": 2048}
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_tokens", "max_bytes"],
      "properties": {
        "max_tokens": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "max_bytes": {"type": "integer", "minimum": 1, "maximum": 16777216}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compiler_version",
        "passport_digest",
        "dependency_digests"
      ],
      "properties": {
        "compiler_version": {"$ref": "#/$defs/version"},
        "passport_digest": {"$ref": "#/$defs/digest"},
        "dependency_digests": {
          "type": "array",
          "maxItems": 512,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/digest"}
        }
      }
    }
  }
}
