{
  "name": "effectgate-preview",
  "version": "1.0.2",
  "description": "Evidence-gated MCP context and effect control runtime",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "effectgate": "src/proxy/effectgate.mjs"
  },
  "files": [
    "LICENSE",
    "README.md",
    "src"
  ],
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Miniks040506/EffectGate.git",
    "directory": "poc"
  },
  "bugs": {
    "url": "https://github.com/Miniks040506/EffectGate/issues"
  },
  "homepage": "https://github.com/Miniks040506/EffectGate#readme",
  "scripts": {
    "start": "node src/proxy/effectgate.mjs mcp serve",
    "benchmark:fixture": "node src/benchmark/fixture-runner.mjs",
    "benchmark:corpus": "node src/benchmark/target-corpus-fixture.mjs",
    "benchmark:claude-capture": "node src/benchmark/claude-capture-adapter.mjs",
    "benchmark:assemble": "node src/benchmark/claude-capture-adapter.mjs assemble",
    "benchmark:observe": "node src/benchmark/observation-runner.mjs",
    "benchmark:report": "node src/benchmark/statistical-report.mjs",
    "benchmark:gate": "node src/benchmark/performance-gate.mjs",
    "benchmark:profile": "node src/benchmark/latency-profile.mjs",
    "benchmark:recommend": "node src/benchmark/exposure-recommendation-cli.mjs",
    "benchmark:target": "node src/benchmark/target-corpus-gate.mjs",
    "benchmark:target-batch": "node src/benchmark/target-corpus-batch.mjs",
    "benchmark:target-local": "node src/benchmark/target-corpus-local-runner.mjs",
    "release:bundle": "node src/release/release-bundle.mjs",
    "release:candidate": "node src/release/release-evidence.mjs",
    "release:approve": "node src/release/release-approval.mjs approve",
    "release:signoff": "node src/release/release-approval.mjs verify",
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "test:routing": "node --test --test-concurrency=1 --test-name-pattern=\"local routing qualification\" test/effectgate.test.mjs",
    "test:security": "node --test test/security-fuzz.test.mjs test/security-resilience.test.mjs test/supply-chain.test.mjs",
    "test:native": "node --test test/native-package-stage.test.mjs"
  }
}
